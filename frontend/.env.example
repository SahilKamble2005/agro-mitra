# OnionTrust AI Environment Variables
# Copy this file to .env and fill in your values

# API Configuration
VITE_API_URL=http://localhost:3001/api
VITE_WS_URL=http://localhost:3001

# Chatbot (OpenAI-compatible API)
# This is used by the BACKEND proxy only — never expose in frontend
# OPENAI_API_KEY=sk-your-key-here

# Map Configuration (Leaflet uses OpenStreetMap by default — no key needed)
# VITE_MAPBOX_TOKEN=your-token-if-using-mapbox

# App Configuration
VITE_APP_NAME=OnionTrust AI
VITE_APP_VERSION=1.0.0
